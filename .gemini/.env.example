# Convergio CLI - API Keys Configuration Example
# Copy this file to .env and add your actual API keys

# PRIMARY PROVIDERS (configure at least one)
# ============================================

# Google Gemini (Recommended primary provider)
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# Anthropic Claude (Advanced reasoning)
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY="your_anthropic_api_key_here"

# OpenAI GPT (General purpose)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY="your_openai_api_key_here"

# OPTIONAL PROVIDERS
# ==================

# Perplexity AI (Research and web search)
# Get your key from: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY="your_perplexity_api_key_here"

# Mistral AI (European provider)
# Get your key from: https://console.mistral.ai/
MISTRAL_API_KEY="your_mistral_api_key_here"

# Google Vertex AI (Enterprise Google AI)
# Get your key from: https://cloud.google.com/vertex-ai/docs/start/api-keys
GOOGLE_API_KEY="your_google_vertex_api_key_here"
GOOGLE_CLOUD_PROJECT="your_google_cloud_project_id"

# OTHER PROVIDERS
# ===============

# XAI Grok
XAI_API_KEY="your_xai_api_key_here"

# OpenRouter (Multiple models)
OPENROUTER_API_KEY="your_openrouter_api_key_here"

# Azure OpenAI
AZURE_OPENAI_API_KEY="your_azure_openai_api_key_here"

# Ollama (Local models)
OLLAMA_API_KEY="your_ollama_api_key_here"

# CONFIGURATION NOTES
# ===================
# 1. Remove the "_here" suffix and replace with your actual API keys
# 2. You only need to configure the providers you want to use
# 3. At least one primary provider (Gemini, Claude, or OpenAI) is required
# 4. Keep this file secure and never commit it to version control
# 5. Run ./check-auth.sh to verify your configuration